name: Build and push image to registry

on:
  push:
    branches: [ "main" ]


jobs:
  build_and_push_image:
    uses: snow-monkeys-modules/docker-iac/.github/workflows/main.yml@main
    with:
      type: build_and_push_image
      name: yabinm/snow-publish-java-selfhosted
      tag: latest
    secrets:
      registry_user: ${{ secrets.GLOBAL_DOCKERHUB_USERNAME }}
      registry_token: ${{ secrets.GLOBAL_DOCKERHUB_TOKEN }}
      snow_token: ${{ secrets.SNOW_TOKEN }}

        },
        {
          "name": "List probes for profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/queue?actorId={{actorId}}&gitType={{gitType}}",
              "host": ["{{baseUrl}}"],
              "path": ["queue"],
              "query": [

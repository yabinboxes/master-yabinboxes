                  "options": { "raw": { "language": "json" } }
                },
                "url": "{{baseUrl}}/queue"
              },
              "status": "Created",
              "code": 201,
              "header": [
                { "key": "Content-Type", "value": "application/json" },
                { "key": "Access-Control-Allow-Origin", "value": "*" }
              ],
              "body": "{\n  \"message\": \"Record inserted\",\n  \"snowName\": \"my-service\"\n}"
            },
            {
              "name": "200 Updated",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"snowName\": \"my-service\",\n  \"healthUrl\": \"https://my-service.example.com/health\",\n  \"actorId\": \"12345\",\n  \"gitType\": \"github\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": "{{baseUrl}}/queue"
              },
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" },
                { "key": "Access-Control-Allow-Origin", "value": "*" }
              ],
              "body": "{\n  \"message\": \"Record updated\",\n  \"snowName\": \"my-service\"\n}"
            },
            {
              "name": "400 Invalid JSON",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "not-json", "options": { "raw": { "language": "text" } } },
                "url": "{{baseUrl}}/queue"
              },
              "status": "Bad Request",
              "code": 400,
              "header": [
                { "key": "Content-Type", "value": "application/json" },
                { "key": "Access-Control-Allow-Origin", "value": "*" }
              ],
              "body": "{\n  \"error\": \"Invalid JSON body\"\n}"
            },
            {
              "name": "422 Missing fields",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"snowName\": \"my-service\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": "{{baseUrl}}/queue"
              },
              "status": "Unprocessable Entity",
              "code": 422,
              "header": [
                { "key": "Content-Type", "value": "application/json" },
                { "key": "Access-Control-Allow-Origin", "value": "*" }
              ],
              "body": "{\n  \"error\": \"Missing required fields: snowName, healthUrl, actorId, gitType\"\n}"
            }
          ]
        },
        {
          "name": "Add or update record (default snowHostUrl)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"snowName\": \"{{snowName}}\",\n  \"healthUrl\": \"{{healthUrl}}\",\n  \"actorId\": \"{{actorId}}\",\n  \"gitType\": \"{{gitType}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/queue",
            "description": "Same as **Add or update record** but omits `snowHostUrl`. The server defaults it to `http://snow-monkeys.com:8080`."
          },
          "response": [
            {
              "name": "201 Inserted",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"snowName\": \"my-service\",\n  \"healthUrl\": \"https://my-service.example.com/health\",\n  \"actorId\": \"12345\",\n  \"gitType\": \"github\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": "{{baseUrl}}/queue"
              },
              "status": "Created",
              "code": 201,
              "header": [
                { "key": "Content-Type", "value": "application/json" },
                { "key": "Access-Control-Allow-Origin", "value": "*" }
              ],
              "body": "{\n  \"message\": \"Record inserted\",\n  \"snowName\": \"my-service\"\n}"

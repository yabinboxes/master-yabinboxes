name: Build and Deploy image in cluster kubernetes

on:
  push:
    branches: [ "main" ]


# build - create image and push to registry
jobs:

  build-and-push-image:
    uses: snow-monkeys-modules/build-and-push-image/.github/workflows/main.yml@main
    with:
      name: yabinm/snow-websocket-bun
      tag: latest
    secrets:
      registry-user: ${{ secrets.GLOBAL_DOCKERHUB_USERNAME }}
      registry-token: ${{ secrets.GLOBAL_DOCKERHUB_TOKEN }}
      snow-token: ${{ secrets.SNOW_TOKEN }}

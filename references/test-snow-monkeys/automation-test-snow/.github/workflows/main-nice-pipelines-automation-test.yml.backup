name: Automation test snow modules

on:
  workflow_dispatch:

env:
  FEATURE_FLAG_TEST_CLOUDFLARE: true
  FEATURE_FLAG_TEST_SNOW_MONKEY: false
  FEATURE_FLAG_TEST_DOCKER: false
  # FEATURE_FLAG_TEST_CLOUDFLARE_PAGE_ASTRO: false
  # FEATURE_FLAG_TEST_CLOUDFLARE_PAGE_REACT: false
  



jobs:


  # Snow Monkeys
  test-snow-monkeys-modules:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Test Snow Monkeys Modules if FEATURE_FLAG_TEST_SNOW_MONKEY is enabled
        if: env.FEATURE_FLAG_TEST_SNOW_MONKEY == 'true' || env.FEATURE_FLAG_TEST_ALL_MODULES == 'true'
        run: |
          echo "------ test snow monkey modules ------"
          curl -L \
          -X POST \
          -H "Accept: application/vnd.github+json" \
          -H "Authorization: Bearer ${{ secrets.SNOW_GITHUB_TOKEN }}" \
          -H "X-GitHub-Api-Version: 2022-11-28" \
          https://api.github.com/repos/test-snow-monkeys/examples/dispatches \
          -d '{"event_type":"automation-snow-monkey-test-event","client_payload":{"unit":false,"integration":true, "feature_flag_test_snow_monkey": true}}'


  # Docker
  test-docker-modules:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Test Docker Modules if FEATURE_FLAG_TEST_DOCKER is enabled
        if: env.FEATURE_FLAG_TEST_DOCKER == 'true' || env.FEATURE_FLAG_TEST_ALL_MODULES == 'true'
        run: |
          echo "------ test docker modules ------"
          curl -L \
          -X POST \
          -H "Accept: application/vnd.github+json" \
          -H "Authorization: Bearer ${{ secrets.SNOW_GITHUB_TOKEN }}" \
          -H "X-GitHub-Api-Version: 2022-11-28" \
          https://api.github.com/repos/test-snow-monkeys/examples/dispatches \
          -d '{"event_type":"automation-docker-test-event","client_payload":{"unit":false,"integration":true, "feature_flag_test_docker": true}}'


  
  # Cloudflare
  test-cloudflare-modules:
    needs:
      - test-snow-monkeys-modules
      - test-docker-modules
    runs-on: ubuntu-latest
    if: (!cancelled() && (needs.test-snow-monkeys-modules.result == 'success' || needs.test-snow-monkeys-modules.result == 'skipped') && (needs.test-docker-modules.result == 'success' || needs.test-docker-modules.result == 'skipped'))
    steps:
      - uses: actions/checkout@v4

      - name: Test Cloudflare Modules if FEATURE_FLAG_TEST_CLOUDFLARE is enabled
        if: env.FEATURE_FLAG_TEST_CLOUDFLARE == 'true' || env.FEATURE_FLAG_TEST_ALL_MODULES == 'true'
        run: |
          echo "------ test cloudflare modules ------"
          curl -L \
          -X POST \
          -H "Accept: application/vnd.github+json" \
          -H "Authorization: Bearer ${{ secrets.SNOW_GITHUB_TOKEN }}" \
          -H "X-GitHub-Api-Version: 2022-11-28" \
          https://api.github.com/repos/test-snow-monkeys/examples/dispatches \
          -d '{"event_type":"automation-cloudflare-test-event","client_payload":{"unit":false,"integration":true, "feature_flag_test_cloudflare": true}}'
    